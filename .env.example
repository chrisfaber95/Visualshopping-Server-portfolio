# Kopieer naar .env en vul echte waarden in. .env staat in .gitignore.
PORT=3001
BASE_URL=https://example.com/

# Database (MySQL 8): DB_NAME is de hoofd-DB, de tweede DB heet vast "shops"
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=cooplubbers_test

# JWT-sleutel voor medewerker- en klantlogin
TOKEN_KEY=

# Sleutel waarmee order-id's in betaal-/bonlinks versleuteld worden.
# Gebruik dezelfde waarde als voorheen, anders werken bestaande links niet meer.
CRYPTR_KEY=

# Mollie
MOLLIE_API=
MOLLIE_TEST_API=
MOLLIE_WEBHOOK=https://example.com/api/v1/mollie/webhook
MOLLIE_ACTIE_WEBHOOK=

# Mail (nodemailer)
MAIL_USER=
MAIL_PASS=
# Ontvanger van Donar-actiebestellingen
DONAR_ORDER_MAIL=
# Ontvanger van feedback uit de app
FEEDBACK_MAIL=
# Spaaractie-reminder wordt alleen naar dit adres gestuurd (testfilter)
REMINDER_TEST_MAIL=

# Alleen nodig als HTTPS in index.js weer aangezet wordt
SSL_PASSPHRASE=
